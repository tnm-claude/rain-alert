# Copy to .env (gitignored, chmod 600). Values here override the DB settings.
# A channel is enabled as soon as its variables are set.

# Slack incoming webhook (Slack: Apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Telegram: run `python scripts/telegram_setup.py <token>` to fill these in
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: where the web UI is reachable from your phone (e.g. Tailscale name).
# Adds an "Open Rain Alert" link to messages.
PUBLIC_BASE_URL=
