<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rain Alert (Flask + APScheduler). Template: scripts/install-service.sh substitutes
     the __PLACEHOLDERS__ and installs the result into ~/Library/LaunchAgents.
     RunAtLoad starts it at login; KeepAlive restarts it if it dies or is killed.
     No secrets here: the app loads them from .env. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>run.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>FLASK_PORT</key>
    <string>__PORT__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- App logs go to logs/rain-alert.log (rotating, see run.py). These two only catch
       interpreter-level crashes before logging is set up, so they stay tiny. -->
  <key>StandardOutPath</key>
  <string>__APP_DIR__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_DIR__/logs/launchd.log</string>
</dict>
</plist>
